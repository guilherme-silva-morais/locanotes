# Copy this file to `.env` and fill in real values for local development.
# Docker Compose reads .env automatically and substitutes ${VAR} in docker-compose.yml.

# ----- PostgreSQL -----
POSTGRES_DB=locanotes_development
POSTGRES_USER=locanotes
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----- Rails backend -----
RAILS_ENV=development
# Generated by `rails new` and stored in backend/config/master.key (gitignored).
# For Docker, mount the file or set this env var to its contents.
# RAILS_MASTER_KEY=

# Used by JwtService (Phase 2). Must be a long random string in real environments.
JWT_SECRET=development-secret-change-me

# Browser origin allowed by Rack::Cors. In production, set to the actual SPA URL.
FRONTEND_ORIGIN=http://localhost:5173

# ----- Vue frontend -----
VITE_API_URL=http://localhost:3000/api/v1
